# ============================================================================
# Keuangan — environment variables (CONTOH)
# Salin file ini menjadi `.env` di root project dan isi kredensial Anda.
# .env di-gitignore; .env.example di-commit.
# ============================================================================

# ---- Database ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keuangan
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- App -----------------------------------------------------------------
APP_NAME=Keuangan
APP_TZ=Asia/Jakarta
APP_LOCALE=id_ID
APP_CURRENCY=IDR
APP_IDLE_TIMEOUT=1800

# ---- Auth throttling ----------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=900

# ---- Ops ----------------------------------------------------------------
APP_ENV=development    # development|production

# ---- Setup / Migration token ---------------------------------------------
# Token rahasia untuk akses /setup.php. Harus sama antara .env dan GitHub Actions secret: DEPLOY_TOKEN.
SETUP_TOKEN=CHANGE-ME-TO-RANDOM-STRING
